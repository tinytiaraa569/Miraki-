{
  "name": "multi-tenant-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start",
    "build": "npm --prefix frontend run build",
    "install:all": "npm --prefix frontend install && npm --prefix backend install",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "backend/**/*.js": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2"
  }
}
