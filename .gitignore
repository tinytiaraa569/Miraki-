

# ---------------------------------------------------------------------------
# Secrets & environment variables  ->  NEVER commit these
# ---------------------------------------------------------------------------
# Ignore every .env variant everywhere in the repo...
.env
.env.*
**/.env
**/.env.*
# ...but ALLOW the documented example templates to be committed.
!.env.example
!**/.env.example

# Private signing keys / certificates
*.key
*.pem
*.p12
*.pfx
**/.keys/
# Allow public keys to be committed (they are meant to be shared)
!*.key.pub

# ---------------------------------------------------------------------------
# Dependencies & build output
# ---------------------------------------------------------------------------
node_modules/
dist/
build/
.next/
coverage/
uploads/

# ---------------------------------------------------------------------------
# Logs & OS / editor cruft
# ---------------------------------------------------------------------------
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
